# Base URL of the backend API, including the /api prefix. No trailing slash.
#
# Local development (copy this file to .env):
VITE_API_BASE_URL=http://localhost:8080/api

# Production - set this in your host's dashboard under Environment Variables,
# then redeploy. Vite inlines the value at BUILD time, so changing it requires a
# rebuild, not just a restart.
#
#   Vercel:    Project > Settings > Environment Variables
#   Netlify:   Site settings > Environment variables
#   Cloudflare:Workers & Pages > Settings > Environment variables
#
# Render backend:
#   VITE_API_BASE_URL=https://job-tracker-backend.onrender.com/api
#
# Leave it unset in production and the app refuses to start with an error naming
# this variable, rather than silently calling localhost.
